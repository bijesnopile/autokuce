# =============================================================================
# Autokuća — primjer konfiguracije. Kopiraj u `.env` i popuni.
# [PROD] = obavezno u produkciji. Prazna vrijednost = isključeno / default.
# Nikad ne commitaj `.env` s pravim vrijednostima.
# =============================================================================

# --- Osnovno ------------------------------------------------------------------
# development | production | test. U production aplikacija odbija start bez
# SECRET_KEY (min 32 znaka) i sa SQLite bazom.
APP_ENV=
# Paket platforme: osnovni | standard | premium (app/plans.py, docs/PAKETI.md). Default osnovni.
# Superadmin ga može privremeno nadjačati na stranici Admin → Sustav (npr. za demo).
PLAN=
# [PROD] Tajni ključ za potpisivanje kolačića i šifriranje TOTP tajni (min 32 znaka).
# Generiraj: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Prazno lokalno: generira se i čuva u data/.dev_secret_key. Prazno u Dockeru: entrypoint ga
# JEDNOM generira u data/.secret_key (data/ mora biti trajni volumen, inače start odbijen); u
# produkciji se nikad ne generira tiho. Ključ se ne smije mijenjati: otisak u bazi → start odbijen.
# Čuvaj ga izvan servera (password manager) — nije dio backupa baze.
SECRET_KEY=
# [PROD] PostgreSQL, npr. postgresql://autokuca:lozinka@db:5432/autokuca
# Prazno = SQLite u data/app.db (samo za lokalni razvoj).
DATABASE_URL=
# [PROD] Javni URL stranice bez kose crte na kraju (linkovi u emailovima, sitemap, canonical).
BASE_URL=
# true kad stranica radi preko HTTPS-a (Secure kolačići + HSTS header).
HTTPS=
# true kad je aplikacija iza Caddyja/Cloudflarea — pravi IP iz CF-Connecting-IP / X-Forwarded-For.
TRUST_PROXY=
# Jezik sučelja (hr; en je primjer prijevoda).
LANGUAGE=
# Mapa za lokalne podatke (baza, media, outbox, backupi). Default ./data
DATA_DIR=

# --- Pohrana slika ------------------------------------------------------------
# local (data/media, servirano kroz /media) | s3 (Cloudflare R2, Hetzner Object Storage...)
STORAGE_BACKEND=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# R2: auto; Hetzner: npr. fsn1
S3_REGION=
# Javni CDN URL za slike (npr. https://media.domena.com). Dodaje se u CSP img-src.
MEDIA_URL=

# --- Email --------------------------------------------------------------------
# console (ispis u log) | file (data/outbox/*.eml — default za demo) | brevo (HTTP API)
EMAIL_BACKEND=
# [PROD] Adresa pošiljatelja (domena mora biti verificirana u Brevu: SPF/DKIM/DMARC).
EMAIL_FROM=
# [PROD kad je EMAIL_BACKEND=brevo] API ključ iz Brevo → SMTP & API → API Keys.
BREVO_API_KEY=

# --- Vanjski servisi (opcionalno; isključeni ako nisu postavljeni) ---------------
# Cloudflare Turnstile anti-spam za javne forme (oba ključa potrebna).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Umami analitika bez kolačića (self-hosted), npr. https://analytics.domena.com/script.js
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# --- Ograničenja i rokovi čuvanja ------------------------------------------------
# Upiti se automatski brišu nakon ovoliko dana (default 365).
INQUIRY_RETENTION_DAYS=
# Prodana vozila ostaju javno vidljiva ovoliko dana, zatim auto-arhiva (default 30).
SOLD_VISIBLE_DAYS=
# Trajanje admin sesije u satima (default 12).
SESSION_HOURS=
# Najviše slika po vozilu (default 30) i najveća veličina jedne slike u MB (default 10).
MAX_IMAGES_PER_VEHICLE=
MAX_UPLOAD_MB=

# --- Administracija i operativa -------------------------------------------------
# Opcionalno: /admin dostupan samo s ovih IP-ova/CIDR-ova, npr. 203.0.113.10,198.51.100.0/24
ADMIN_IP_ALLOWLIST=
# true = dnevni maintenance (retencija, arhiva prodanih) u pozadinskoj niti aplikacije u 04:00.
# Alternativa: cron `python -m app.cli maintenance` (deploy/crontab.example).
MAINTENANCE_IN_APP=
# Lozinka za seed korisnike (admin@domena.com, vlasnik@domena.com, prodavac1@domena.com).
# Default: Promijeni-me-2026!  — [PROD] obavezno promijeni.
SEED_PASSWORD=
# Razina logiranja (INFO, WARNING...).
LOG_LEVEL=
# Ubaci demo podatke (16 vozila, upiti, pretplatnici) pri prvom pokretanju na praznoj bazi.
# true samo za demo/prezentacijsku instancu; za pravog klijenta false.
DEMO_SEED=

# --- Docker / deployment (docker-compose.yml, deploy/) ---------------------------
# [PROD] Domena stranice za Caddy (npr. auto.domena.hr). Prazno = http://localhost (lokalni test).
DOMAIN=
# [PROD] Lozinka PostgreSQL korisnika (generira deploy/new-client.sh). Samo slova i brojke.
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
# Docker slika aplikacije (default autokuca:latest, gradi se iz ovog repozitorija).
AUTOKUCA_IMAGE=
# Broj uvicorn workera u kontejneru (default 2).
WEB_CONCURRENCY=

# --- Backup (deploy/backup.sh) — obično u deploy/backup.env za sve klijente ---------
# Javni ključ za šifriranje backupa: age (preporučeno, "age1...") ili GPG (ID/email ključa).
# Privatni ključ NE drži na serveru — potreban je samo za vraćanje (deploy/restore.sh).
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
# rclone odredište za kopije izvan servera, npr. storagebox:autokuca ili r2:backup-bucket
BACKUP_RCLONE_REMOTE=
# Koliko dana čuvati backupe lokalno i na odredištu (default 30).
BACKUP_RETENTION_DAYS=
