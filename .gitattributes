# Normaliziraj završetke redaka; repozitorij se commita s Windowsa, a
# shell/Docker/Python datoteke se izvode na Linux VPS-u i moraju imati LF.
* text=auto

*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.caddy     text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.toml      text eol=lf
*.mako      text eol=lf
Dockerfile  text eol=lf
Dockerfile.* text eol=lf
*.example   text eol=lf
Caddyfile   text eol=lf
.dockerignore text eol=lf
.env.example  text eol=lf
crontab.example text eol=lf
# Ostale tekstualne datoteke također LF (dosljedno na Windowsu i Linuxu).
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.svg       text eol=lf
*.xml       text eol=lf

# Binarne datoteke
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.gz    binary
