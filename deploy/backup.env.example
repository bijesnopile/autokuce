# Zajednička konfiguracija backupa za sve klijente na VPS-u.
# cp deploy/backup.env.example deploy/backup.env && chmod 600 deploy/backup.env
# Vrijednosti u clients/<ime>/.env imaju prednost.

# Javni age ključ (preporučeno). Par ključeva napravi NA SVOM RAČUNALU:
#   age-keygen -o autokuca-backup.key   → "Public key: age1..." upiši ovdje;
#   privatni ključ (autokuca-backup.key) čuvaj izvan servera (password manager + offline kopija).
BACKUP_AGE_RECIPIENT=
# Alternativa bez age: GPG javni ključ uvezen na serveru (gpg --import), ID ili email ključa.
BACKUP_GPG_RECIPIENT=

# rclone odredište (rclone config → npr. Hetzner Storage Box preko SFTP-a, ili S3/R2).
BACKUP_RCLONE_REMOTE=
BACKUP_RETENTION_DAYS=30

# Samo za test vraćanja na serveru: putanja do privatnog age ključa (inače ostavi prazno).
BACKUP_AGE_IDENTITY=
