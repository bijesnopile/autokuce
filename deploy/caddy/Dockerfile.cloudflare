# Caddy s modulom caddy-dns/cloudflare — samo za varijantu "Let's Encrypt preko DNS izazova"
# (umjesto Cloudflare Origin certifikata). Token: Cloudflare → My Profile → API Tokens →
# "Edit zone DNS" za zone klijenata → CLOUDFLARE_API_TOKEN u deploy/caddy/.env.
FROM caddy:2.10-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2.10
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
